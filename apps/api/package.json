{
  "name": "@todam/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "API REST Fastify de Todam.",
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "predev": "pnpm --filter @todam/database db:migrate",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "openapi:check": "tsx src/openapi/check.ts",
    "openapi:write": "tsx src/openapi/write.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@aws-sdk/client-s3": "3.1148.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@todam/contracts": "workspace:*",
    "@todam/database": "workspace:*",
    "@todam/domain": "workspace:*",
    "better-auth": "1.7.7",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
