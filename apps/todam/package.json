{
  "name": "@todam/todam",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Application universelle Expo Web, iOS et Android de Todam.",
  "main": "expo-router/entry",
  "scripts": {
    "build": "tsx scripts/generate-sitemap.ts && expo export --platform web",
    "dev": "expo start --web",
    "lint": "eslint .",
    "start": "expo start",
    "test": "vitest run test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@expo/vector-icons": "^15.0.2",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.1",
    "@todam/contracts": "workspace:*",
    "@todam/design-system": "workspace:*",
    "better-auth": "1.7.5",
    "expo": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-native": "0.87.1",
