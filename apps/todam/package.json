    "react-native-worklets": "0.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "57.0.12",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
