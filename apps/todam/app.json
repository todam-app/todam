{
  "expo": {
    "name": "Todam",
    "slug": "todam",
    "scheme": "todam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.todam.mobile"
    },
    "android": {
      "package": "app.todam.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
