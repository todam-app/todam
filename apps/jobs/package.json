{
  "name": "@todam/jobs",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Imports et tâches serveur de Todam.",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/catalog-import.ts --format esm --dts --clean",
    "catalog:coverage": "tsx src/catalog-import.ts --coverage",
    "catalog:import": "tsx src/catalog-import.ts",
    "lint": "eslint src test",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@todam/contracts": "workspace:*",
    "@todam/database": "workspace:*",
    "@todam/domain": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
