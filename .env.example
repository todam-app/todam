NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://todam:todam@127.0.0.1:5432/todam
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000/v1/auth
WEB_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
PUBLIC_WEB_URL=http://localhost:8081
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# E-mails transactionnels (Brevo)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Todam
TODAM_OPERATIONS_EMAIL=

# Identité publique de l'éditeur non professionnel
LEGAL_OPERATOR_NAME=
EXPO_PUBLIC_LEGAL_OPERATOR_NAME=

# Coordonnées publiques des hébergeurs
PRIMARY_HOST_NAME=OVH SAS
PRIMARY_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France
PRIMARY_HOST_PHONE=+33 9 72 10 10 07
PRIMARY_HOST_URL=https://www.ovhcloud.com
OBJECT_HOST_NAME=Cloudflare, Inc.
OBJECT_HOST_ADDRESS=101 Townsend Street, San Francisco, CA 94107, USA
OBJECT_HOST_URL=https://www.cloudflare.com
EXPO_PUBLIC_PRIMARY_HOST_NAME=OVH SAS
EXPO_PUBLIC_PRIMARY_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France
EXPO_PUBLIC_PRIMARY_HOST_PHONE=+33 9 72 10 10 07
EXPO_PUBLIC_PRIMARY_HOST_URL=https://www.ovhcloud.com
EXPO_PUBLIC_OBJECT_HOST_NAME=Cloudflare, Inc.
EXPO_PUBLIC_OBJECT_HOST_ADDRESS=101 Townsend Street, San Francisco, CA 94107, USA
EXPO_PUBLIC_OBJECT_HOST_URL=https://www.cloudflare.com

# Activer uniquement dans la commande de publication après remplissage complet
LEGAL_RELEASE_READY=false

# Synchronisation du catalogue national
# Base des lieux utilise son API publique par défaut ; surcharger seulement pour test.
TODAM_BASE_LIEUX_URL=
# URL d'un export JSON/JSON-LD DATAtourisme autorisé pour le projet.
TODAM_DATATOURISME_URL=
# OpenAgenda exige une clé API et une liste explicite d'agendas séparés par des virgules.
TODAM_OPENAGENDA_API_KEY=
TODAM_OPENAGENDA_AGENDA_UIDS=
TODAM_OPENAGENDA_API_URL=https://api.openagenda.com/v2/agendas
TODAM_OPENAGENDA_DISCOVERY_TERMS=théâtre,opéra,ballet,spectacle vivant

# Stockage objet S3/R2 des seules affiches dont la politique vaut mirror.
TODAM_OBJECT_ENDPOINT=
TODAM_OBJECT_REGION=auto
TODAM_OBJECT_BUCKET=
TODAM_OBJECT_ACCESS_KEY_ID=
TODAM_OBJECT_SECRET_ACCESS_KEY=
TODAM_OBJECT_PUBLIC_BASE_URL=
